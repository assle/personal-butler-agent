DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DATABASE_URL=sqlite+aiosqlite:///butler.db

# 联网搜索配置（默认关闭；启用后 search_web 工具可查询实时信息）
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=8

# 天气查询配置（Open-Meteo 无需 API Key）
WEATHER_TIMEOUT_SECONDS=8

# 企业微信智能机器人 URL 回调模式配置（消息接收 + response_url 回复）
# 在企业微信后台配置 URL: https://<你的域名>/api/wechat/aibot/callback
WECOM_AIBOT_BOT_ID=
WECOM_AIBOT_TOKEN=
WECOM_AIBOT_ENCODING_AES_KEY=

# 向量嵌入配置（Qwen3-Embedding via DashScope，不配则使用本地哈希嵌入）
DASHSCOPE_API_KEY=

# APScheduler 企业微信群 webhook 主动推送配置
# 真实 webhook 文件不要提交，参考 config/scheduler_targets.example.json 创建 local 文件
SCHEDULER_TARGETS_FILE=

# Phase 1 异步研究任务（默认关闭，需要 Redis + 企微自建应用）
RESEARCH_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
RESEARCH_QUEUE_NAME=butler-research
RESEARCH_MAX_ROUNDS=4
RESEARCH_TIMEOUT_SECONDS=300

# 企业微信自建应用主动私聊配置（仅 RESEARCH_ENABLED=true 时必填）
# 与上方的 WECOM_AIBOT_* 智能机器人回调配置相互独立
WECOM_APP_CORP_ID=
WECOM_APP_SECRET=
WECOM_APP_AGENT_ID=0
