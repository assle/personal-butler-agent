DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DATABASE_URL=sqlite+aiosqlite:///butler.db

# 企业微信智能机器人 URL 回调模式配置（消息接收 + response_url 回复）
# 在企业微信后台配置 URL: https://<你的域名>/api/wechat/aibot/callback
WECOM_AIBOT_BOT_ID=
WECOM_AIBOT_TOKEN=
WECOM_AIBOT_ENCODING_AES_KEY=

# APScheduler 定时推送配置
# 当前 URL 回调模式不启动 WebSocket，主动定时推送暂不可用
# 四个字段均支持 | 分隔多个值，按位置配对
# TYPE/ID/MESSAGE 数量必须一致；INTENT 空位走自动路由，也可单值广播或全空自动判定
# 单目标示例: TARGET_TYPE=single, TARGET_ID=AssLe, MESSAGE=早安！, INTENT=
# 多目标示例: TARGET_TYPE=single|group, TARGET_ID=AssLe|chatid123, MESSAGE=练什么？|吃什么？, INTENT=today_plan|
SCHEDULER_CRON=0 9 * * *
SCHEDULER_TARGET_TYPE=single
SCHEDULER_TARGET_ID=
SCHEDULER_MESSAGE=今日训练建议
SCHEDULER_INTENT=today_plan
