DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DATABASE_URL=sqlite+aiosqlite:///butler.db

# 企业微信自建应用配置（回调消息加解密）
# 填 CorpID 和 Token 后，/api/wechat/callback 路由才会注册
WECHAT_CORP_ID=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=
WECHAT_AGENT_ID=

# 企业微信智能机器人长连接模式配置（WebSocket，消息接收 + 回复 + 主动推送）
# 填 BotID 和 Secret 后，应用启动时自动建立长连接
WECOM_AIBOT_BOT_ID=
WECOM_AIBOT_SECRET=

# APScheduler 定时推送配置（通过智能机器人长连接主动推送 LLM 生成的内容）
# 需要先配置 WECOM_AIBOT_BOT_ID 才会生效
SCHEDULER_CRON=0 9 * * *
SCHEDULER_TARGET_TYPE=single
SCHEDULER_TARGET_ID=
SCHEDULER_MESSAGE=今日训练建议
SCHEDULER_INTENT=today_plan
