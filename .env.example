DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DATABASE_URL=sqlite+aiosqlite:///butler.db

# 企业微信自建应用配置（回调消息加解密）
# 填 CorpID 和 Token 后，/api/wechat/callback 路由才会注册
WECHAT_CORP_ID=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=
WECHAT_AGENT_ID=

# 企业微信智能机器人 API 模式配置（回调消息加解密，receiveid 为空字符串）
# 填 Token 和 EncodingAESKey 后，/api/wechat/robot/callback 路由才会注册
WECHAT_ROBOT_TOKEN=
WECHAT_ROBOT_ENCODING_AES_KEY=

# 企业微信群机器人 Webhook 推送地址
WECHAT_WEBHOOK_URL=
