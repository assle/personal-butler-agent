DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DATABASE_URL=sqlite+aiosqlite:///butler.db

# 企业微信 CorpID（用于服务端 API 调用，如获取用户信息等）
# 需要同时配置 WECOM_CORP_SECRET 才会生效
WECHAT_CORP_ID=

# 企业微信服务端 API 密钥（用于获取 access_token，调用用户信息等接口）
# 需要同时配置 WECHAT_CORP_ID 才会生效
WECOM_CORP_SECRET=

# 企业微信智能机器人长连接模式配置（WebSocket，消息接收 + 回复 + 主动推送）
# 填 BotID 和 Secret 后，应用启动时自动建立长连接
WECOM_AIBOT_BOT_ID=
WECOM_AIBOT_SECRET=

# APScheduler 定时推送配置（通过智能机器人长连接主动推送 LLM 生成的内容）
# 需要先配置 WECOM_AIBOT_BOT_ID 才会生效
SCHEDULER_CRON=0 9 * * *
SCHEDULER_TARGET_TYPE=single
SCHEDULER_TARGET_ID=
SCHEDULER_MESSAGE=今日训练建议
SCHEDULER_INTENT=today_plan
